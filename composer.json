{
    "name": "pavlakis/date-utils",
    "description": "Date and time utilities for Aikido",
    "type": "library",
    "require": {
        "php": "~8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Pavlakis\\Aikido\\Utils\\DateTimeHelper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pavlakis\\Aikido\\Utils\\DateTimeHelper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "pp": [
            "@check-styles",
            "@phpstan",
            "@test"
        ],
        "phpstan": [
            "@run-static-analysis"
        ],
        "check-styles": "php-cs-fixer fix --allow-risky=yes --dry-run",
        "fix-styles": "php-cs-fixer fix --allow-risky=yes",
        "test": "phpunit --bootstrap vendor/autoload.php tests",
        "run-static-analysis": "phpstan analyse src/ --level 7"
    }
}
